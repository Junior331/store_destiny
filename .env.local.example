# API Configuration
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=https://auth-api-p7l2.onrender.com
NEXT_PUBLIC_CLIENT_TOKEN=token1

# Cloudflare Turnstile
# Obtenha sua chave em: https://dash.cloudflare.com/
# Para desenvolvimento, você pode usar a chave de teste: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Chave de criptografia para cookies
# IMPORTANTE: Gere uma chave forte e única em produção
# Exemplo: openssl rand -base64 32
NEXT_PUBLIC_ENCRYPTION_KEY=your-strong-encryption-key-here-change-in-production